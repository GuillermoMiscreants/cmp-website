{
  "name": "astro-playground",
  "type": "module",
  "version": "0.0.1",
  "//starterVersion": "The starter release this tree is at. A template-repo copy inherits this value and never bumps it again, which is what records the baseline a client build was cut from. Bump it here in the same change as a docs/changelog.md entry.",
  "starterVersion": "2.14",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "//spellcheck": "Whole repo, not just src — every page, every doc. Advisory by design: --no-exit-code means it reports and never fails a build. Deliberately NOT part of `check`; see docs/rules/content.md [content.copy].",
    "spellcheck": "cspell \"**/*.{astro,ts,mjs,md,mdx,css,json,jsonc}\" --no-progress --no-must-find-files --no-exit-code --unique",
    "check": "npm run typecheck && npm run docs:check && npm run build",
    "docs:build": "node scripts/build-doc-links.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "astro": "astro",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.6.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.1.5",
    "@sanity/visual-editing": "^6.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.1.6",
    "astro-icon": "^1.1.5",
    "astro-portabletext": "^1.0.1",
    "groq": "^6.16.0",
    "gsap": "^3.14.2",
    "mimetext": "^3.0.28",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@iconify-json/lucide": "^1.2.101",
    "cspell": "^10.0.1",
    "typescript": "^6.0.3"
  }
}
