---
import Layout from "../layouts/Layout.astro";
import PageView from "../components/blocks/PageView.astro";
import { loadPage } from "../lib/sanity/load";
import { isPreview } from "../lib/sanity/preview";

// Static on the production build. Server-rendered on the preview deployment.
export const prerender = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED !== "true";

const preview =
  (import.meta.env.DEV || import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true") &&
  isPreview(Astro.cookies);
const { page, settings } = await loadPage("home", preview);
---

{
  page ? (
    <PageView page={page} settings={settings} preview={preview} />
  ) : (
    <Layout title="Home">
      <main id="main" class="container-page py-24">
        <h1 class="h1">No home page yet</h1>
        <p class="mt-4 text-body-lg text-fg-muted">Publish a page with the slug home to fill this route.</p>
      </main>
    </Layout>
  )
}
