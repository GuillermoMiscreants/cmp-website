---
import SectionMain from "../../SectionMain.astro";
import Blocks from "../Blocks.astro";
import {
  alignClass,
  sectionPadding,
  sectionVariantProps,
  spacing,
  type Align,
  type Background,
  type SectionPadding,
  type SectionVariant,
  type Spacing,
} from "../../../lib/variants";
import { clean } from "../../../lib/sanity/clean";
import { dataSanity } from "../../../lib/sanity/preview";
import type { PageBlock } from "../../../lib/sanity/load";

interface Props {
  block: PageBlock;
  preview: boolean;
  documentId: string;
  eager?: boolean;
}

const { block, preview, documentId, eager = false } = Astro.props;

function isSectionPadding(value: string): value is SectionPadding {
  return sectionPadding.some((item) => item.value === value);
}

function isSpacing(value: string): value is Spacing {
  return spacing.some((item) => item.value === value);
}

/** Prefer the new edge field. Older sections stored one `spacing` value for both. */
function sectionPad(value: string | null | undefined, legacy: string | null | undefined): Spacing {
  const chosen = clean(value);
  if (isSectionPadding(chosen)) return chosen;
  const previous = clean(legacy);
  if (isSpacing(previous)) return previous;
  return "md";
}

const path = `sections[_key=="${block._key}"]`;
const variant = clean(block.variant) as SectionVariant;
const width = sectionVariantProps[variant] ?? sectionVariantProps.default;
const bg = clean(block.background) as Background;
const theme = bg === "dark" || bg === "brand" ? bg : undefined;
const paddingTop = sectionPad(block.paddingTop, block.spacing);
const paddingBottom = sectionPad(block.paddingBottom, block.spacing);
const align = (["left", "center", "right"] as const).includes(clean(block.align) as Align)
  ? (clean(block.align) as Align)
  : "left";
---

<SectionMain
  id={block._key}
  paddingTop={paddingTop}
  paddingBottom={paddingBottom}
  contentPadding={width.contentPadding}
  borderTop={Boolean(block.borderTop)}
  class:list={[bg === "muted" && "bg-panel-muted"]}
  data-theme={theme}
  data-sanity={dataSanity(preview, documentId, path)}
  contentClass={[width.contentClass, alignClass[align]].filter(Boolean).join(" ")}
>
  <div data-sanity={dataSanity(preview, documentId, `${path}.content`)}>
    <Blocks
      blocks={block.content ?? []}
      preview={preview}
      documentId={documentId}
      basePath={`${path}.content`}
      inheritedAlign={align}
      eager={eager}
    />
  </div>
</SectionMain>
