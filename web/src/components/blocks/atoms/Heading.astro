---
import {
  alignClass,
  headingSizeClass,
  headingTag,
} from "../../../lib/variants";
import { pick } from "../../../lib/sanity/clean";
import { dataSanity } from "../../../lib/sanity/preview";
import type { BlockRenderProps } from "../../../lib/sanity/load";

type Props = BlockRenderProps;
const { block, preview, documentId, path, inheritedAlign = "left" } = Astro.props;
const level = pick(headingTag, block.level, "2");
const size = pick(headingSizeClass, block.size, "h2");
const align = pick(alignClass, block.align || inheritedAlign, inheritedAlign);
const attr = dataSanity(preview, documentId, path);
const className = [size, align];
---

{level === "h1" && <h1 class:list={className} data-sanity={attr}>{block.text}</h1>}
{level === "h2" && <h2 class:list={className} data-sanity={attr}>{block.text}</h2>}
{level === "h3" && <h3 class:list={className} data-sanity={attr}>{block.text}</h3>}
{level === "h4" && <h4 class:list={className} data-sanity={attr}>{block.text}</h4>}
