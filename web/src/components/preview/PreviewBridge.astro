---
import PreviewEditing from "./PreviewEditing.tsx";
---

<PreviewEditing client:only="react" />

<style is:global>
  /*
    Presentation chrome only. The overlay ring, hover line, and drop marker
    share one green so the block under the pointer reads as a single target.
  */
  .preview-guide {
    background-color: #53924d;
  }

  /* Full-page loader shown while a moved section waits for the refreshed page. */
  [data-move-loader] {
    position: fixed;
    inset: 0;
    z-index: 2147483645;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    background: color-mix(in srgb, var(--color-canvas) 70%, transparent);
    backdrop-filter: blur(2px);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 150ms ease, visibility 0s linear 150ms;
  }

  [data-move-loader][data-visible] {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .move-loader-spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid var(--color-stroke-strong);
    border-top-color: #53924d;
    border-radius: 50%;
    animation: move-loader-spin 0.8s linear infinite;
  }

  @keyframes move-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .move-loader-spinner {
      animation-duration: 2.4s;
    }
  }

  /*
    Typing on the page. The text under edit gets the same green ring, and the
    overlay and hover controls step aside so clicks and the caret reach it.
  */
  [data-text-editing-target] {
    outline: 2px solid #53924d;
    outline-offset: 3px;
    cursor: text;
  }

  html[data-text-editing] sanity-visual-editing {
    visibility: hidden;
    pointer-events: none;
  }

  html[data-text-editing] [data-insert-anchor],
  html[data-text-editing] [data-block-tab] {
    display: none;
  }

  /*
    Block picker modal. Rendered as a dark island (data-theme="dark") so it
    reads the dark semantic tokens whatever theme the page uses.
  */
  .bp-root {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    pointer-events: auto;
    font-family: var(--font-sans);
    color: var(--color-fg);
  }

  .bp-backdrop {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 12vh 1rem 1rem;
    background: color-mix(in srgb, var(--color-canvas) 55%, transparent);
    backdrop-filter: blur(2px);
  }

  .bp-modal {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 38rem;
    max-height: min(34rem, 76vh);
    overflow: hidden;
    border: 1px solid var(--color-stroke-strong);
    border-radius: var(--radius-card);
    background: var(--color-panel);
    box-shadow: var(--shadow-popover);
  }

  .bp-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    color: var(--color-fg-muted);
  }

  .bp-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    font-size: 1.125rem;
    line-height: 1.75rem;
  }

  .bp-search input::placeholder {
    color: var(--color-fg-subtle);
  }

  .bp-modal kbd {
    display: inline-block;
    min-width: 1.25rem;
    padding: 0.0625rem 0.375rem;
    border: 1px solid var(--color-stroke-strong);
    border-radius: 0.25rem;
    color: var(--color-fg-muted);
    font: inherit;
    font-size: 0.6875rem;
    line-height: 1.25rem;
    text-align: center;
  }

  .bp-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.375rem;
    background: transparent;
    color: var(--color-fg-muted);
    cursor: pointer;
  }

  .bp-close:hover {
    color: var(--color-fg);
    background: var(--color-stroke);
  }

  .bp-tabs {
    display: flex;
    gap: 1.25rem;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .bp-tab {
    margin-bottom: -1px;
    padding: 0.5rem 0 0.625rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--color-fg-subtle);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }

  .bp-tab:hover,
  .bp-tab[aria-selected="true"] {
    color: var(--color-fg);
  }

  .bp-tab[aria-selected="true"] {
    border-bottom-color: var(--color-fg);
  }

  .bp-list {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .bp-empty {
    margin: 0;
    padding: 2rem 1rem;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .bp-item {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-fg);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .bp-item[aria-selected="true"] {
    background: var(--color-panel-muted);
  }

  .bp-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-stroke);
    border-radius: 0.5rem;
    color: var(--color-success);
  }

  .bp-text {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }

  .bp-label {
    font-size: 0.9375rem;
    line-height: 1.25rem;
  }

  .bp-hint {
    overflow: hidden;
    color: var(--color-fg-subtle);
    font-size: 0.75rem;
    line-height: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bp-group {
    flex: none;
    color: var(--color-fg-subtle);
    font-size: 0.75rem;
  }

  .bp-footer {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1.25rem;
    border-top: 1px solid var(--color-stroke);
    color: var(--color-fg-subtle);
    font-size: 0.75rem;
  }

  .bp-error {
    color: var(--color-fg);
  }

  /*
    One tab per block: drag handle, name, remove. It is ours, so the pointer
    can travel onto it. Presentation's own tab is hidden; the page-level
    "Home" tab was the second one that showed in the gaps between blocks.
  */
  sanity-visual-editing [data-hovered] [data-ui="Flex"]:has(> [data-ui="Flex"] > [data-ui="Text"]):not(:has(a)) {
    display: none !important;
  }

  .block-tab {
    position: fixed;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.5rem;
    background: #53924d;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    pointer-events: auto;
  }

  .block-tab [data-block-tab-drag] {
    display: inline-flex;
    margin-left: -0.25rem;
    line-height: 0;
    cursor: grab;
  }

  .block-tab button {
    display: inline-flex;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    line-height: 0;
    cursor: pointer;
  }

  .block-tab button:hover {
    opacity: 0.72;
  }

  sanity-visual-editing,
  sanity-visual-editing :where(*) {
    --card-focus-ring-color: #53924d !important;
  }

  sanity-visual-editing [style*="556bfc"] {
    background: #53924d !important;
  }
</style>
