---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";

// Polymorphic: renders <a> when `href` is set, otherwise <button>. Extends the
// button attribute set so callers can pass any native attribute (data-*,
// aria-*, …) without us listing each one, plus the few anchor props we forward
// (§5.1). Deliberately NOT an intersection with HTMLAttributes<"a"> — that form
// makes every attribute optional-on-both and weakens the hints callers get.
interface Props extends HTMLAttributes<"button"> {
  label?: string;
  variant?: "primary" | "secondary" | "tertiary";
  /** Render as an <a> pointing here instead of a <button>. */
  href?: string;
  /** Anchor-only; forwarded when `href` is set. */
  target?: string;
  /** Anchor-only; defaults to "noopener noreferrer" when target="_blank". */
  rel?: string;
  withArrow?: boolean;
  arrowDirection?: "right" | "left";
}

const {
  label = "Learn More",
  variant = "primary",
  href,
  type = "button",
  target,
  rel,
  disabled = false,
  withArrow = true,
  arrowDirection = "right",
  class: className,
  ...rest
} = Astro.props;

const Tag = href && !disabled ? "a" : "button";

const base =
  "group inline-flex items-center justify-center whitespace-nowrap font-medium text-sm h-10 px-4 gap-2 cursor-pointer " +
  "transition-colors outline-none " +
  "focus-visible:ring-2 focus-visible:ring-focus focus-visible:ring-offset-2 focus-visible:ring-offset-canvas " +
  "disabled:pointer-events-none disabled:opacity-50 " +
  "aria-disabled:pointer-events-none aria-disabled:opacity-50";

const variants = {
  primary:
    "bg-intent text-fg-on-intent hover:bg-intent-hover",
  secondary:
    "border border-stroke bg-transparent text-fg hover:bg-panel-muted",
  tertiary:
    "bg-transparent text-fg hover:bg-panel-muted",
};

const arrowName =
  arrowDirection === "left" ? "lucide:arrow-left" : "lucide:arrow-right";

// Auto-safety: if linking external with target=_blank, add noopener/noreferrer
// unless the caller explicitly provided rel.
const safeRel =
  target === "_blank" ? (rel ?? "noopener noreferrer") : rel;
---

<Tag
  {...rest}
  href={Tag === "a" ? href : undefined}
  type={Tag === "button" ? type : undefined}
  target={Tag === "a" ? target : undefined}
  rel={Tag === "a" ? safeRel : undefined}
  disabled={Tag === "button" && disabled ? true : undefined}
  aria-disabled={disabled ? "true" : undefined}
  class:list={[base, variants[variant], className]}
>
  <span><slot>{label}</slot></span>

  {withArrow && (
    <span
      class="relative inline-block h-4 w-4 overflow-hidden shrink-0 motion-reduce:overflow-visible "
      aria-hidden="true"
    >
      <span
        class:list={[
          "absolute inset-0 transition-transform duration-300 ease-in-out motion-reduce:transition-none",
          arrowDirection === "right"
            ? "group-hover:translate-x-full"
            : "group-hover:-translate-x-full",
        ]}
      >
        <Icon name={arrowName} class="h-4 w-4" />
      </span>
      <span
        class:list={[
          "absolute inset-0 transition-transform duration-300 ease-in-out motion-reduce:hidden",
          arrowDirection === "right"
            ? "-translate-x-full group-hover:translate-x-0"
            : "translate-x-full group-hover:translate-x-0",
        ]}
      >
        <Icon name={arrowName} class="h-4 w-4" />
      </span>
    </span>
  )}
</Tag>
