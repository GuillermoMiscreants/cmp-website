---
import SectionMain from "./SectionMain.astro";
import { sanityClient } from "sanity:client";
import { PAGES_QUERY } from "../utils/sanity";

const pages = (await sanityClient.fetch(PAGES_QUERY)).filter(
  (page): page is { _id: string; title: string | null; slug: string } =>
    typeof page.slug === "string",
);
---

{
  pages.length > 0 && (
    <SectionMain id="pages" borderTop>
      <h2 class="h2">Pages</h2>
      <ul class="mt-6 flex flex-col gap-3">
        {pages.map((page) => (
          <li>
            <a
              class="text-fg underline underline-offset-4"
              href={page.slug === "home" ? "/" : `/${page.slug}`}
            >
              {page.title ?? "Untitled"}
            </a>
          </li>
        ))}
      </ul>
    </SectionMain>
  )
}
