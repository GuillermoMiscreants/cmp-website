# Public — safe to expose to the browser. Loaded by Astro and astro.config.mjs.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Origin of the standalone Studio (`sanity dev`), not a path on the Astro app.
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only. Create a Viewer token at sanity.io/manage and paste it here.
# Also copy it into .dev.vars so the Cloudflare preview worker can read it locally.
SANITY_API_READ_TOKEN=

# Server-only write token for scripts/seed.ts. Never commit a real value.
SANITY_API_WRITE_TOKEN=

# Documented for deploy checklists. Presentation authenticates with Sanity's
# preview URL secret (validated using the read token), not this string.
SANITY_PREVIEW_SECRET=
